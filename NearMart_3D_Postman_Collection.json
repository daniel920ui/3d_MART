{
  "info": {
    "name": "NearMart 3D REST API Collection",
    "description": "Comprehensive Postman collection for NearMart 3D Supermarket & Grocery Marketplace",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "authToken",
      "value": "token-usr-customer-1-CUSTOMER"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@nearmart.com\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"David Miller\",\n  \"email\": \"david@example.com\",\n  \"phone\": \"+1 555-0177\",\n  \"password\": \"David@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Supermarkets & Products",
      "item": [
        {
          "name": "Get All Supermarkets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/stores?locality=all", "host": ["{{baseUrl}}"], "path": ["stores"] }
          }
        },
        {
          "name": "Get Supermarket Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/stores/store-1/products", "host": ["{{baseUrl}}"], "path": ["stores", "store-1", "products"] }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        }
      ]
    },
    {
      "name": "Cart & Checkout",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
          }
        },
        {
          "name": "Add Item to Basket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"store-1\",\n  \"productId\": \"prod-1\",\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/cart/items", "host": ["{{baseUrl}}"], "path": ["cart", "items"] }
          }
        },
        {
          "name": "Place Order (Checkout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Jane Doe\",\n  \"customerPhone\": \"+1 555-0199\",\n  \"deliveryAddress\": \"Apt 4B, 350 Maple Avenue, Downtown Metro\",\n  \"fulfilmentMethod\": \"DELIVERY\",\n  \"paymentMethod\": \"DEMO_PAYMENT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/checkout", "host": ["{{baseUrl}}"], "path": ["checkout"] }
          }
        },
        {
          "name": "Get User Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        }
      ]
    },
    {
      "name": "Shop Owner",
      "item": [
        {
          "name": "Get Owner Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token-usr-owner-1-SHOP_OWNER" }],
            "url": { "raw": "{{baseUrl}}/owner/dashboard", "host": ["{{baseUrl}}"], "path": ["owner", "dashboard"] }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer token-usr-owner-1-SHOP_OWNER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PACKING\",\n  \"note\": \"Items gathered and packed at counter.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/owner/orders/ord-1002/status", "host": ["{{baseUrl}}"], "path": ["owner", "orders", "ord-1002", "status"] }
          }
        }
      ]
    },
    {
      "name": "Administrator",
      "item": [
        {
          "name": "Get Admin Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token-usr-admin-1-ADMIN" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token-usr-admin-1-ADMIN" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        }
      ]
    }
  ]
}
